{
  "expo": {
    "name": "Gestão Escolar",
    "slug": "testeprover",
    "scheme": "desafio-prover",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/favicon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d4ed8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.desafioprover.gestaoescolar"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/favicon.png",
        "backgroundImage": "./assets/favicon.png",
        "monochromeImage": "./assets/favicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.desafioprover.gestaoescolar"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "baseUrl": "/teste-prover"
    },
    "extra": {
      "eas": {
        "projectId": "51cb2ac0-9d18-42ca-92e3-ffbd301cbb37"
      },
      "router": {}
    },
    "owner": "ckituxi"
  }
}
